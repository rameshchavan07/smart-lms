generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institute {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  address     String?  @db.Text
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(255)
  website     String?  @db.VarChar(255)
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  courses     Course[]
}

model User {
  id                String            @id @default(uuid())
  firstName         String            @db.VarChar(100)
  lastName          String            @db.VarChar(100)
  email             String            @unique @db.VarChar(255)
  phoneNumber       String?           @db.VarChar(20)
  address           String?           @db.Text
  passwordHash      String?
  role              UserRole
  profileImage      String?
  googleId          String?           @db.VarChar(255)
  isActive          Boolean           @default(true)
  isEmailVerified   Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  instituteId       String?
  institute         Institute?        @relation(fields: [instituteId], references: [id])
  auditLogs         AuditLog[]
  driveFiles        GoogleDriveFile[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  refreshTokens     RefreshToken[]
  student           Student?
  teacher           Teacher?
  discussions       Discussion[]
  discussionReplies DiscussionReply[]
  sentMessages      Message[]         @relation("SentMessages")
  receivedMessages  Message[]         @relation("ReceivedMessages")
  chatGroupMembers  ChatGroupMember[]

  @@index([email])
}

model Teacher {
  id             String    @id @default(uuid())
  userId         String    @unique
  employeeCode   String    @unique @db.VarChar(50)
  specialization String?   @db.VarChar(255)
  qualification  String?   @db.VarChar(255)
  joiningDate    DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  courses        Course[]
  announcements  Announcement[]
  user           User      @relation(fields: [userId], references: [id])

  @@index([employeeCode])
}

model Student {
  id               String                 @id @default(uuid())
  userId           String                 @unique
  studentCode      String?                @db.VarChar(50)
  enrollmentNumber String                 @unique @db.VarChar(100)
  academicYear     String?                @db.VarChar(50)
  admissionDate    DateTime?              @db.Date
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  submissions      AssignmentSubmission[]
  quizSubmissions  QuizSubmission[]
  attendance       Attendance[]
  enrollments      Enrollment[]
  certificates     Certificate[]
  user             User                   @relation(fields: [userId], references: [id])

  @@index([enrollmentNumber])
}

model Course {
  id             String          @id @default(uuid())
  title          String          @db.VarChar(255)
  description    String?
  thumbnailUrl   String?
  teacherId      String?
  maxStudents    Int?
  status         CourseStatus    @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  instituteId    String?
  institute      Institute?      @relation(fields: [instituteId], references: [id])
  assignments    Assignment[]
  teacher        Teacher?        @relation(fields: [teacherId], references: [id])
  enrollments    Enrollment[]
  lectures       Lecture[]
  studyMaterials StudyMaterial[]
  quizzes        Quiz[]
  discussions    Discussion[]
  announcements  Announcement[]
  chatGroups     ChatGroup[]
  certificates   Certificate[]

  @@index([teacherId])
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

model Lecture {
  id           String       @id @default(uuid())
  courseId     String
  title        String       @db.VarChar(255)
  description  String?
  meetingUrl   String?
  recordingUrl      String?
  recordingDuration Int?
  recordingSize     Int?
  thumbnailUrl      String?
  startTime    DateTime
  endTime      DateTime
  createdBy    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attendance   Attendance[]
  course       Course       @relation(fields: [courseId], references: [id])

  @@index([courseId])
}

model Attendance {
  id        String           @id @default(uuid())
  lectureId String
  studentId String
  joinTime  DateTime?
  leaveTime DateTime?
  status    AttendanceStatus
  lecture   Lecture          @relation(fields: [lectureId], references: [id])
  student   Student          @relation(fields: [studentId], references: [id])

  @@index([lectureId])
  @@index([studentId])
}

model Assignment {
  id          String                 @id @default(uuid())
  courseId    String
  title       String                 @db.VarChar(255)
  description String?
  dueDate     DateTime
  totalMarks  Int
  rubric      Json?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  course      Course                 @relation(fields: [courseId], references: [id])
  submissions AssignmentSubmission[]

  @@index([courseId])
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  studentId    String
  fileUrl      String
  marks            Int?
  feedback         String?
  rubricEvaluation Json?
  submittedAt      DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  @@index([assignmentId])
  @@index([studentId])
}

model StudyMaterial {
  id          String   @id @default(uuid())
  courseId    String
  title       String   @db.VarChar(255)
  description String?
  fileUrl     String
  fileType    String   @db.VarChar(50)
  fileSize    Int?
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id])
}

model Quiz {
  id           String           @id @default(uuid())
  courseId     String
  title        String           @db.VarChar(255)
  description  String?
  durationMins Int?
  totalMarks   Int
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  submissions  QuizSubmission[]

  @@index([courseId])
}

model QuizQuestion {
  id        String       @id @default(uuid())
  quizId    String
  text      String       @db.Text
  marks     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   QuizOption[]
  answers   QuizAnswer[]

  @@index([quizId])
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  text       String       @db.VarChar(500)
  isCorrect  Boolean      @default(false)
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    QuizAnswer[]

  @@index([questionId])
}

model QuizSubmission {
  id          String       @id @default(uuid())
  quizId      String
  studentId   String
  totalScore  Int?
  submittedAt DateTime     @default(now())
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@unique([quizId, studentId])
  @@index([studentId])
}

model QuizAnswer {
  id               String         @id @default(uuid())
  submissionId     String
  questionId       String
  selectedOptionId String?
  submission       QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question         QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuizOption?    @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model GoogleDriveFolder {
  id            String   @id @default(uuid())
  driveFolderId String   @unique
  path          String   @unique
  folderName    String
  createdAt     DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String   @db.VarChar(255)
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model GoogleDriveFile {
  id          String   @id @default(uuid())
  driveFileId String   @unique
  fileName    String   @db.VarChar(255)
  fileUrl     String
  uploadedBy  String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [uploadedBy], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String   @db.VarChar(255)
  entityType String   @db.VarChar(100)
  entityId   String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpToken {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  type      OtpType
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Discussion {
  id        String            @id @default(uuid())
  courseId  String
  userId    String
  title     String            @db.VarChar(255)
  content   String            @db.Text
  isPinned  Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])
  replies   DiscussionReply[]

  @@index([courseId])
}

model DiscussionReply {
  id           String     @id @default(uuid())
  discussionId String
  userId       String
  content      String     @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@index([discussionId])
}

model Message {
  id         String     @id @default(uuid())
  senderId   String
  receiverId String?
  groupId    String?
  content    String     @db.Text
  fileUrl    String?    @db.VarChar(255)
  fileType   String?    @db.VarChar(50)
  fileName   String?    @db.VarChar(255)
  isRead     Boolean    @default(false)
  createdAt  DateTime   @default(now())
  sender     User       @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User?      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  group      ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([groupId])
}

model ChatGroup {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  courseId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members   ChatGroupMember[]
  messages  Message[]

  @@index([courseId])
}

model ChatGroupMember {
  id        String    @id @default(uuid())
  groupId   String
  userId    String
  joinedAt  DateTime  @default(now())
  
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Announcement {
  id        String   @id @default(uuid())
  courseId  String?
  teacherId String?
  title     String   @db.VarChar(255)
  content   String   @db.Text
  createdAt DateTime @default(now())
  
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([teacherId])
}

model Integration {
  id          String   @id @default(uuid())
  provider    String   @unique @db.VarChar(100) // e.g. "Zoom", "GoogleDrive", "Stripe"
  isActive    Boolean  @default(false)
  apiKey      String?  @db.Text
  apiSecret   String?  @db.Text
  config      Json?    // Store any additional config
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Certificate {
  id          String   @id @default(uuid())
  studentId   String
  courseId    String
  issueDate   DateTime @default(now())
  certificateUrl String?
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}
